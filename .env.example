# Copy this file to .env and replace the placeholder values.
# Keep .env private: never commit it or share it publicly.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=madam
ADMIN_PASSWORD=replace-with-a-strong-password

# Leave DATABASE_URL empty to use the local students.db SQLite file.
# Render sets DATABASE_URL to its PostgreSQL database automatically.
DATABASE_URL=
FLASK_DEBUG=true

# Change any of these to false to hide an optional registration field.
COLLECT_MOBILE=true
COLLECT_GENDER=true
COLLECT_COLLEGE_REG=true
